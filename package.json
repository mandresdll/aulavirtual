{
  "name": "plataforma-cursos-uta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @plataforma/shared build && pnpm --parallel --filter @plataforma/shared --filter @plataforma/api --filter @plataforma/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @plataforma/api test:integration",
    "test:e2e": "playwright test",
    "docs:capturas": "playwright test --config tests/manual/playwright.config.ts",
    "licenses:check": "node scripts/check-licenses.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
