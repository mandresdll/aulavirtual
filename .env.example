# =============================================================================
# Plataforma de Cursos UTA · variables de entorno
# Copia este archivo como `.env` (nunca lo subas al repositorio) y ajusta los valores.
# La API valida todas las variables con Zod al arrancar (apps/api/src/config/env.ts):
# si falta una obligatoria, no arranca y muestra qué variable corregir.
# Las variables vacías (`FOO=`) se consideran no definidas.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | staging | production. En production se bloquean los adaptadores simulados.
APP_ENV=development
APP_VERSION=0.1.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# true si la API está detrás de un proxy (nginx del contenedor web o proxy institucional).
TRUST_PROXY=false

# URLs públicas (sin barra final). En desarrollo con `pnpm dev` la SPA corre en Vite (5173).
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# Orígenes permitidos por CORS separados por coma. Por defecto: PUBLIC_WEB_URL.
CORS_ORIGINS=

# --- PostgreSQL (docker compose) ----------------------------------------------
# Credenciales del contenedor local. En staging/producción usa valores robustos y distintos.
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambiar-esta-clave-local
POSTGRES_DB=plataforma
# Conexión desde tu máquina (pnpm dev). Dentro de compose se arma sola con los valores de arriba.
DATABASE_URL=postgresql://plataforma:cambiar-esta-clave-local@localhost:5432/plataforma
# Base de pruebas de integración (la crea infra/postgres/init al primer arranque).
TEST_DATABASE_URL=postgresql://plataforma:cambiar-esta-clave-local@localhost:5432/plataforma_test

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379/1

# --- Rate limit global (por IP) ----------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Catálogo y SEO --------------------------------------------------------------
# Caché en Redis de listados y fichas (segundos). Los cambios del panel tardan a lo más esto.
CATALOG_CACHE_TTL_SECONDS=60
# Caché de cupos disponibles (segundos): corta para mostrarlos casi en tiempo real.
SEATS_CACHE_TTL_SECONDS=15
# true solo en producción: permite que los buscadores indexen el sitio (robots.txt y meta
# robots). En desarrollo y staging debe quedar en false para no publicar contenido de prueba.
SEO_ALLOW_INDEXING=false

# --- Correo ---------------------------------------------------------------------
# smtp | memory (memory solo para pruebas). En desarrollo, Mailpit: http://localhost:8025
MAILER_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Cursos UTA <no-responder@example.com>
# Casilla de la UTA que recibe alertas (p. ej. fallos de matrícula en el Aula Virtual).
UTA_ALERT_EMAIL=

# --- Adaptadores de integración -------------------------------------------------
# Cada integración tiene un adaptador simulado (mock) y uno real. Ver docs/integraciones.md.
# Solo en APP_ENV=production: permite mocks de forma explícita (no recomendado).
ALLOW_MOCK_ADAPTERS=false

# Pasarela de pagos (Q1): mock | webpay
PAYMENT_GATEWAY_DRIVER=mock
# integration | production
WEBPAY_ENVIRONMENT=integration
# Credenciales entregadas por Transbank. Las de integración son públicas en la documentación
# de Transbank; las de producción las entrega el CFT y nunca se versionan.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# Aula Virtual (Q4): mock | moodle
LMS_DRIVER=mock
MOODLE_URL=
# Token del servicio web de Moodle con las funciones habilitadas (ver docs/integraciones.md).
MOODLE_TOKEN=
# Id del rol "estudiante" en Moodle (por defecto 5).
MOODLE_STUDENT_ROLE_ID=5

# Proveedor de identidad institucional (Q2): mock | oidc
IDENTITY_DRIVER=mock
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email

# API del SGA para roles y permisos (Q7): mock | http
SGA_DRIVER=mock
SGA_API_URL=
SGA_API_TOKEN=
SGA_ROLES_CACHE_TTL_SECONDS=300

# Validador de certificados del SGA (Q5): mock | sga
CERTIFICATE_VALIDATOR_DRIVER=mock
CERTIFICATE_VALIDATOR_URL=
CERTIFICATE_VALIDATOR_TOKEN=

# Emisión de boletas/facturas (Q6): mock | export | http
INVOICING_DRIVER=mock
INVOICING_API_URL=
INVOICING_API_TOKEN=

# Asistente de IA (EX-04): solo `disabled` en esta entrega.
AI_ASSISTANT_DRIVER=disabled

# --- Docker compose (staging/producción) ---------------------------------------
# Registro y etiqueta de las imágenes. En local se construyen como plataforma/*:local.
IMAGE_REGISTRY=plataforma
IMAGE_TAG=local
