{
  "name": "@plataforma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "prisma generate --no-hints && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "smoke": "node --input-type=module -e \"await import('./dist/app.js'); process.exit(0)\"",
    "typecheck": "prisma generate --no-hints && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "prisma generate --no-hints && vitest run --project integration --no-file-parallelism",
    "test:coverage": "prisma generate --no-hints && vitest run --coverage --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@plataforma/shared": "workspace:*",
    "@prisma/client": "~6.19.3",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.3.1",
    "openapi-types": "^12.1.3",
    "openid-client": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "prisma": "~6.19.3",
    "qrcode": "^1.5.4",
    "transbank-sdk": "^6.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-cli": "^11.1.0",
    "jose": "^6.2.15",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
